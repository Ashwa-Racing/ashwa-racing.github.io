{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ashwaracing",
  "main": "./worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/admin", "/admin/*", "/admin.html", "/_admin/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
